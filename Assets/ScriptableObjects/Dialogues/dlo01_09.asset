  fundoPainel: {fileID: 0}
  nodes:
  - text: "Gra\xE7as a voc\xEA e seu pai, o templo est\xE1 recheado de p\xE3o e carne,
      continue assim!"
    speakerSide: 1
    speakerName: Sacerdote
    portrait: {fileID: 0}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "Nunca esque\xE7o minhas oferendas."
    speakerSide: 1
    speakerName: Sacerdote
    portrait: {fileID: 0}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: Muito bom, filho, o Fulgor aprecia seu gesto.
    speakerSide: 1
    speakerName: Sacerdote
    portrait: {fileID: 0}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0

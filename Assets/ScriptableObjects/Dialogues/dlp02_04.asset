MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 998d816f9ecd779408036895027b9b91, type: 3}
  m_Name: dlp02_04
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  portraitEsquerda: {fileID: 0}
  portraitDireita: {fileID: 0}
  fundoPainel: {fileID: 0}
  nodes:
  - text: "Eles amea\xE7am nossos pontos fracos, temos que machucar o deles."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: 8070572476435812613, guid: 3d2db493b5e5ffa46877dfdebf579893, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: Ponto fraco? Qual o nosso ponto fraco?
    speakerSide: 0
    speakerName: 
    portrait: {fileID: -8774304836102649413, guid: 42c019abed3c7b44a8180c97944bf800, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "S\xE3o as pessoas, \xE9 claro."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "Voc\xEA s\xF3 se meteu nessa por causa do seu pai e eu por causa do meu
      filho."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "N\xE3o saberia o que fazer sem ele."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "O seu tio, faz isso pela fam\xEDlia."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: O Herbalista, faz pra se redimir dos seus erros com os pacientes falecidos.
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "J\xE1 o Costureiro, faz pelos Desgarrados e pela mem\xF3ria da sua m\xE3e."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: -2999815174450519269, guid: 9c3bd70cb784dfd4c8aaf2e8e07f08b5, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
  - text: "Acerte os pontos fracos desses monstros, menino, \xE9 nossa \xFAnica chance."
    speakerSide: 1
    speakerName: Carpinteira
    portrait: {fileID: 8070572476435812613, guid: 3d2db493b5e5ffa46877dfdebf579893, type: 3}
    acaoDeQuest: 0
    questDef: {fileID: 0}
    estadoQuest: 0
